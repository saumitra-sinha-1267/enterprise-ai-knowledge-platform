# ==============================================================================
# Enterprise AI Knowledge Platform — Environment Configuration
# ==============================================================================

PROJECT_NAME="Enterprise AI Knowledge Platform"
ENVIRONMENT=development
DEBUG=True

# Security & JWT
# IMPORTANT: Generate a secure 32+ character key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev_secret_jwt_key_enterprise_rag_2026_super_secure_random_token_demo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Relational Database (PostgreSQL for Docker/Production, SQLite fallback for local testing)
# SQLite fallback: sqlite:///./enterprise_rag.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_rag
DATABASE_URL=sqlite:///./enterprise_rag.db

# Vector Database Configuration
# Options: "qdrant", "memory"
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=enterprise_knowledge_base
# When QDRANT_IN_MEMORY=True, Qdrant client runs embedded locally without requiring an external container
QDRANT_IN_MEMORY=True

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Chunking & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.25

# LLM Provider Configuration
# Supported options: "offline_mock", "openai", "anthropic", "ollama"
# Default is "offline_mock" which provides deterministic, grounded generation without requiring paid API keys!
LLM_PROVIDER=offline_mock

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama Configuration (Optional local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Security & Prompt Guard
PROMPT_INJECTION_PROTECTION_ENABLED=True
MAX_QUERY_LENGTH=1000
AUDIT_LOG_ENABLED=True

# UI & Integration
BACKEND_API_URL=http://localhost:8000
