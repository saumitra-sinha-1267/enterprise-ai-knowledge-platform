{
  "benchmark_metadata": {
    "version": "1.0",
    "description": "Evaluation dataset for Secure RAG System retrieval accuracy, answer faithfulness, and RBAC isolation."
  },
  "test_cases": [
    {
      "id": "TC-HR-001",
      "category": "domain_grounding",
      "query": "How many weeks of paid parental leave does the company provide to caregivers?",
      "target_department": "hr",
      "target_document": "hr_leave_and_benefits_policy.txt",
      "expected_keywords": ["16 weeks", "parental leave", "caregivers"],
      "authorized_roles": ["admin", "hr"],
      "unauthorized_roles": ["finance", "engineering", "employee"]
    },
    {
      "id": "TC-HR-002",
      "category": "domain_grounding",
